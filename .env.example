# Leave the Supabase keys empty to run in DEMO MODE (data is stored in your browser only).
# Fill them from Supabase dashboard → Project Settings → API.
# If you use the Cloudflare proxy (supabase/cloudflare-proxy-worker.js), put your proxy domain in the URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Photos (member profile photos, website main photo and gallery) are stored on Cloudinary.
# Cloudinary dashboard → Settings → API Keys. The API secret stays on the server and is never sent to browsers.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
